    sin
    sinf
    cos
    cosf
    tan
    tanf
    asin
    asinf
    acos
    acosf
    atan
    atanf
    atan2
    atan2f
    sqrt
    sqrtf
    fmod
    fmodf
    log
    logf
    log2
    log2f
    log10
    log10f
    exp
    expf
    exp2
    exp2f
    pow
    powf
    ldexp
    ldexpf
    frexp
    floor
    floorf
    ceil
    ceilf
    trunc
    truncf
    fabs
    nearbyint
    nearbyintf
    rint
    rintf
    round
    roundf
    _dsign
    _fdsign
    _dclass
    _fdclass
    abort
    terminate

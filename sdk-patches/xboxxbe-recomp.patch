+// (primitive, index count, 16 bit indices, vertices, stride), both in the title's memory: the vertices up to the
+// highest index are copied out like DrawVerticesUP's
+HLE_STDCALL(D3DDevice_DrawIndexedVerticesUP, 5) {
+    std::lock_guard<std::recursive_mutex> lock(g_lock);
+    Walk(Dev(kDevPush));
+    if (!g_backend || !a[1] || !a[2] || !a[3] || !a[4]) return 0;
+    SyncDeferred();
+    const uint16_t* idx = static_cast<const uint16_t*>(HostPtr(a[2]));
+    uint32_t top = 0;
+    for (uint32_t i = 0; i < a[1]; i++) top = std::max<uint32_t>(top, idx[i]);
+    auto stream = g_state.streams[0];
+    g_state.streams[0] = {UpVertices(HostPtr(a[3]), (top + 1) * a[4]), a[4]};
+    g_backend->Draw(g_state, a[0], 0, a[1], reinterpret_cast<const uint8_t*>(idx));
+    g_state.streams[0] = stream;
+    return 0;
+}
